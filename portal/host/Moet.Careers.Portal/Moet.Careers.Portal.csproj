<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MoET careers portal server (Ministry of Economy & Tourism): serves the candidate app and its small JSON API, and is
       the only part that calls the recruitment API (with the portal's service key). No database, no other packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Moet.Careers.Portal</RootNamespace>
    <AssemblyName>Moet.Careers.Portal</AssemblyName>
    <Company>Ministry of Economy &amp; Tourism</Company>
    <Product>MoET Careers Portal</Product>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moet.Careers.Portal.Tests" />
  </ItemGroup>

</Project>
