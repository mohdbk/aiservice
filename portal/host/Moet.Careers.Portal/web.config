<?xml version="1.0" encoding="utf-8"?>
<!-- The careers portal site on IIS (Ministry of Economy & Tourism): the candidate app and its server, in this one app.
     Published with the portal; deploy/iis/Install-Moet.ps1 adds the settings as environment variables. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Moet.Careers.Portal.dll" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
      <security>
        <!-- CVs are sent as JSON (base64), up to the portal's 30 MB limit. -->
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="33554432" />
        </requestFiltering>
      </security>
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />
      <httpErrors existingResponse="PassThrough" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
