# --- Frappe HR ---
# Base URL of the Frappe HR site (no trailing slash)
FRAPPE_URL=https://hr.example.gov.ae

# Option A (first run / demo): Administrator password. Used ONLY to bootstrap:
# creates the AI custom fields, the webhook, and a least-privilege service user
# ("HR User" role) whose API keys the service then uses for everything else.
FRAPPE_ADMIN_PASSWORD=

# Option B (production): skip admin access entirely. Pre-create the service user,
# custom fields and webhook (or let a one-off Option A run do it), then supply keys.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

SERVICE_USER_EMAIL=ai-agent@example.com

# Public URL of THIS service — Frappe posts new-applicant webhooks here
SERVICE_PUBLIC_URL=https://ai.example.gov.ae

# Shared secrets (generate long random strings)
WEBHOOK_TOKEN=change-me
MCP_TOKEN=change-me

# --- LLM: any OpenAI-compatible endpoint ---
# Demo:    OpenRouter  -> https://openrouter.ai/api/v1  + qwen/qwen3.8-27b
# On-prem: vLLM/Ollama -> http://llm.internal:8000/v1  + your served model name
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# Create sample job openings + fake CVs when the site has no job openings
SEED_DEMO=false

# false = MCP gateway only (recommended once the ai_recruitment Frappe app is installed)
MANAGE_FRAPPE=false
