<?xml version="1.0" encoding="utf-8"?>
<!-- MoET recruitment backoffice on IIS (Ministry of Economy & Tourism). Written by Install-Moet.ps1 from
     deploy/iis/templates; edit the settings file and run the script again rather than editing this file.
     IIS serves the built React app and forwards /api to the recruitment API (URL Rewrite + Application Request
     Routing), so staff browsers talk to one address: the sign-in cookie stays SameSite=Strict and the API's
     same-origin check holds. The script also turns on ARR's proxy with the original Host kept, no response
     buffering (the assistant streams its answers) and a 10 minute timeout. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Health" stopProcessing="true">
          <match url="^healthz$" />
          <action type="CustomResponse" statusCode="200" statusReason="OK" statusDescription="ok" />
        </rule>
        <rule name="Forwarded proto" stopProcessing="false">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="None" />
        </rule>
        <!-- The undecoded address, so encoded characters in paths and queries reach the API exactly as sent. -->
        <rule name="API" stopProcessing="true">
          <match url="^api/" />
          <conditions>
            <add input="{UNENCODED_URL}" pattern="^/api/(.*)" />
          </conditions>
          <action type="Rewrite" url="{{API_URL}}/api/{C:1}" appendQueryString="false" />
        </rule>
        <!-- Single page app: every other path that is not a file is handled by the React router. -->
        <rule name="App" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/assets/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent>
      <!-- index.html is checked on every visit, so a new version reaches staff straight away. -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
    <security>
      <requestFiltering removeServerHeader="true">
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Built files have a hash in their names: cached for a year. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- The API sets its own security headers (CV previews may be framed by the backoffice), so only HSTS is added here.
       Search text and file names can hold "%" and "+". The assistant's stream must not be compressed. -->
  <location path="api">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <clear />
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering allowDoubleEscaping="true" />
      </security>
      <urlCompression doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
