<?xml version="1.0" encoding="utf-8"?>
<!-- MoET careers portal on IIS (Ministry of Economy & Tourism). Written by Install-Moet.ps1 from deploy/iis/templates;
     edit the settings file and run the script again rather than editing this file.
     IIS starts the portal's Node server through the ASP.NET Core Module (out of process): the module starts node.exe,
     gives it a private port in ASPNETCORE_PORT, forwards every request to it, adds X-Forwarded-For and
     X-Forwarded-Proto, and starts it again if it stops. The Node server serves the pages and its small API. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="{{NODE}}" arguments="&quot;{{DIR}}\server\src\server.js&quot;" hostingModel="OutOfProcess"
                  processesPerApplication="1" startupTimeLimit="60" shutdownTimeLimit="10" requestTimeout="00:03:00"
                  stdoutLogEnabled="true" stdoutLogFile=".\logs\node">
        <environmentVariables>
{{ENV}}
        </environmentVariables>
      </aspNetCore>
      <security>
        <!-- CVs are sent as JSON (base64), up to the portal's 30 MB body limit. -->
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="33554432" />
        </requestFiltering>
      </security>
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />
      <httpErrors existingResponse="PassThrough" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
