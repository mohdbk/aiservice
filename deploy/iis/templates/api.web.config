<?xml version="1.0" encoding="utf-8"?>
<!-- MoET recruitment API on IIS (Ministry of Economy & Tourism). Written by Install-Moet.ps1 from deploy/iis/templates;
     edit the settings file and run the script again rather than editing this file. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process: the API runs inside the IIS worker. The first start creates or updates the database before it
           answers, hence the long startup limit. Logs go to the Windows Event Log (Application); set
           stdoutLogEnabled to true for a while when the API does not start, and read logs\stdout*. -->
      <aspNetCore processPath="dotnet" arguments=".\{{DLL}}" hostingModel="inprocess" startupTimeLimit="600" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
{{ENV}}
        </environmentVariables>
      </aspNetCore>
      <security>
        <!-- Search text and file names can hold "%" and "+"; nothing here maps to files on disk. -->
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
      <!-- The assistant streams its answer (text/event-stream); compression would hold it back until the end. -->
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
      <!-- The API's own JSON errors reach the caller instead of IIS error pages. -->
      <httpErrors existingResponse="PassThrough" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
