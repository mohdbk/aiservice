<Project Sdk="Microsoft.NET.Sdk">

  <!-- The recruitment agent (Ministry of Economy & Tourism): a Microsoft Agent Framework agent served over the AG-UI
       protocol by the API, inside the API's process. Its tools call the backoffice API as the signed-in staff member,
       show results as A2UI surfaces, and can only propose changes. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Moet.Recruitment.Agent</RootNamespace>
    <AssemblyName>Moet.Recruitment.Agent</AssemblyName>
    <Company>Ministry of Economy &amp; Tourism</Company>
    <Product>MoET Recruitment Agent</Product>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);MEAI001;MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.28.0-preview.261106.1" />
  </ItemGroup>

  <!-- The same implicit usings as a web project (the code was written as one). -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moet.Recruitment.Agent.Tests" />
  </ItemGroup>

</Project>
