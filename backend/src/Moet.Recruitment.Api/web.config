<?xml version="1.0" encoding="utf-8"?>
<!-- The backoffice site on IIS (Ministry of Economy & Tourism): the staff app, its API and the recruitment assistant, in
     this one app. Published with the API; deploy/iis/Install-Moet.ps1 adds the settings as environment variables. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process. The first start creates or updates the database before the site answers, hence the long limit.
           Logs go to the Windows Event Log (Application); set stdoutLogEnabled to true for a while when the site does
           not start, and read logs\stdout*. -->
      <aspNetCore processPath="dotnet" arguments=".\Moet.Recruitment.Api.dll" hostingModel="inprocess" startupTimeLimit="600"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" />
      <security>
        <!-- Search text and file names can hold "%" and "+". Uploads up to 50 MB. -->
        <requestFiltering removeServerHeader="true" allowDoubleEscaping="true">
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
      <!-- The assistant streams its answers (text/event-stream); compression would hold them back until the end. -->
      <urlCompression doStaticCompression="true" doDynamicCompression="false" />
      <!-- The app's own JSON errors and pages reach the browser instead of IIS error pages. -->
      <httpErrors existingResponse="PassThrough" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
