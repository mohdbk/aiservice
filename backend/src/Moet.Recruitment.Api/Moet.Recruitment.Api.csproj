<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Api: HTTP endpoints for the career portal backend (service key) and the recruitment backoffice (staff sign-in),
       and the host for the backoffice's static files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Moet.Recruitment.Api</RootNamespace>
    <AssemblyName>Moet.Recruitment.Api</AssemblyName>
    <Company>Ministry of Economy &amp; Tourism</Company>
    <Product>MoET Recruitment</Product>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moet.Recruitment.Application\Moet.Recruitment.Application.csproj" />
    <ProjectReference Include="..\Moet.Recruitment.Infrastructure\Moet.Recruitment.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moet.Recruitment.Api.Tests" />
  </ItemGroup>

</Project>
