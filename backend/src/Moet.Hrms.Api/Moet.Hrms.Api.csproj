<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Api: HTTP endpoints for the career portal backend (service key) and the recruitment backoffice (staff sign-in),
       the recruitment assistant (run inside this process), and, when the built backoffice is in wwwroot, the backoffice
       itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Moet.Hrms.Api</RootNamespace>
    <AssemblyName>Moet.Hrms.Api</AssemblyName>
    <Company>Ministry of Economy &amp; Tourism</Company>
    <Product>MoET Recruitment</Product>
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);MEAI001;MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moet.Hrms.Application\Moet.Hrms.Application.csproj" />
    <ProjectReference Include="..\Moet.Hrms.Infrastructure\Moet.Hrms.Infrastructure.csproj" />
    <ProjectReference Include="..\Moet.Hrms.Agent\Moet.Hrms.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Moet.Hrms.Api.Tests" />
  </ItemGroup>

</Project>
